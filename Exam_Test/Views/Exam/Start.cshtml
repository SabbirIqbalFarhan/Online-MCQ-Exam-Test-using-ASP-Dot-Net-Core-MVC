@model List<Exam_Test.Models.Question>

@{
    ViewData["Title"] = "Exam";
    int moduleId = ViewBag.ModuleId;
    int sessionId = ViewBag.SessionId;
    string sessionTitle = ViewBag.SessionTitle;
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Module @moduleId Exam</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            font-family: Arial, sans-serif;
            background: #fff;
            overflow: hidden;
            height: 100%;
            width: 100%;
        }

            .page-wrapper {
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: calc(100vh - 90px);
                height: calc(100dvh - 90px);
                display: flex;
                flex-direction: column;
                overflow: hidden;
                background: #fff;
            }

        .top-bar {
            background: #fff;
            border-bottom: 2px solid #ddd;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 5px 12px;
            flex-shrink: 0;
            min-height: 44px;
        }

        .top-bar .info { font-size: 13px; color: #c00; font-weight: 700; }
        .top-bar .q-number { font-size: 26px; font-weight: 900; color: #222; }

        .progress-box {
            background: #1F8C0C;
            color: #fff;
            font-size: 13px;
            font-weight: 900;
            padding: 5px 14px;
            border-radius: 8px;
            min-width: 64px;
            text-align: center;
        }

        .middle-section {
            display: flex;
            border-bottom: 2px solid #ddd;
            flex: 0 0 35vh;
            max-height: 260px;
            min-height: 120px;
            background: #fff;
            overflow: hidden;
        }

        .img-side {
            flex: 0 0 45%;
            border-right: 2px solid #ddd;
            overflow: hidden;
            background: #fafafa;
        }

        .img-side img {
            width: 100%;
            height: 100%;
            object-fit: fill;
            display: block;
        }

        .text-side {
            flex: 1;
            padding: 12px 16px;
            display: flex;
            align-items: flex-start;
            background: #fff;
            overflow-y: auto;
        }

        .text-side-full {
            width: 100%;
            padding: 12px 16px;
            display: flex;
            align-items: flex-start;
            background: #fff;
            overflow-y: auto;
        }

        .text-side p, .text-side-full p {
            font-size: 20px;
            font-weight: 600;
            color: #222;
            line-height: 1.6;
        }

        .options-section {
            background: #e0e0e0;
            border-top: 1px solid #111;
            flex: 1;
            overflow-y: auto;
            min-height: 0;
        }

        .option-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    border-bottom: 1px solid #111;
    padding: 6px 16px;
    cursor: pointer;
    background: #e0e0e0;
    transition: background 0.15s;
    min-height: 38px;
}
        .option-row:hover { background: #d0d0d0; }
        .option-row.selected { background: #9e9e9e; }

        .opt-letter {
            font-size: 24px;
            font-weight: 900;
            color: #111;
            width: 50px;
            flex-shrink: 0;
            text-align: center;
            line-height: 1;
        }

        .opt-text {
            flex: 1;
            font-size: 18px;
            color: #333;
            font-weight: 900;
            line-height: 1;
            padding-top: 0;       /* remove padding-top */
            display: flex;        /* add this */
            align-items: center;  /* add this */
        }

        .opt-check {
    width: 32px;
    height: 32px;
    border: 2px solid #aaa;
    border-radius: 4px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #d0d0d0;
    font-size: 22px;
    font-weight: 900;
    color: #000;
}

.option-row.selected .opt-check { background: #888; border-color: #666; color: #000; }
        .bottom-strip {
            position: fixed;
            bottom: 0px;
            left: 0;
            width: 100vw;
            background: #d0d0d0;
            display: flex;
            align-items: center;
            padding: 4px 6px;
            gap: 4px;
            border-top: 2px solid #bbb;
            flex-shrink: 0;
            height: 90px;
            z-index: 100;
            overflow: visible;
        }

        .arrow-btn-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            width: 88px;
            height: 88px;
        }

        .arrow-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 88px;
            height: 88px;
        }

        .arrow-btn:hover { filter: brightness(1.15); }

        .q-nums-wrap {
            display: flex;
            flex-wrap: nowrap;
            gap: 2px;
            align-items: center;
            flex: 1;
            min-width: 0;
            overflow-x: auto;
            overflow-y: visible;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        .q-nums-wrap::-webkit-scrollbar { display: none; }

        .q-dot {
            flex: 1 1 0;
            height: 26px;
            border-radius: 3px;
            background: #ebebeb;
            border: 1px solid #bbb;
            color: #c00;
            font-size: 10px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: 0.15s;
            min-width: 20px;
            position: relative;
        }

        .q-dot.active {
            background: #1F8C0C;
            color: #fff;
            border-color: #1F8C0C;
        }

        .q-dot.answered {
            background: #ebebeb;
            color: #000;
            border-color: #bbb;
        }

        /* The triangle is a separate fixed element moved by JS */
        #activeTriangle {
            position: fixed;
            z-index: 200;
            width: 0;
            height: 0;
            border-left: 14px solid transparent;
            border-right: 14px solid transparent;
            border-bottom: 32px solid #1F8C0C;
            pointer-events: none;
            transition: left 0.15s;
        }

        .submit-btn {
            background: #1F8C0C;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 0 14px;
            height: 44px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            flex-shrink: 0;
            display: none;
            white-space: nowrap;
        }

        .submit-btn:hover { background: #32e012; }
        .submit-btn.visible { display: block; }

        .popup-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }

        .popup-overlay.show { display: flex; }

        .popup-box {
            background: #fff;
            border-radius: 14px;
            padding: 24px 28px;
            max-width: 360px;
            width: 88%;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }

        .popup-box h3 { font-size: 17px; font-weight: 800; color: #1a2236; margin-bottom: 10px; }
        .popup-box p { font-size: 14px; color: #64748b; margin-bottom: 20px; line-height: 1.6; }
        .popup-btns { display: flex; gap: 10px; justify-content: center; }

        .popup-btn-ok {
            background: #1F8C0C; color: #fff; border: none;
            border-radius: 8px; padding: 10px 22px;
            font-size: 14px; font-weight: 700; cursor: pointer;
        }

        .popup-btn-cancel {
            background: #f1f5f9; color: #374151; border: none;
            border-radius: 8px; padding: 10px 22px;
            font-size: 14px; font-weight: 700; cursor: pointer;
        }

        .popup-btn-ok:hover { background: #32e012; }
        .popup-btn-cancel:hover { background: #e2e8f0; }

        @@media (max-width: 480px) {
                    .page-wrapper {
                        height: calc(100vh - 56px);
                        height: calc(100dvh - 56px);
                    }

            .top-bar { padding: 3px 8px; min-height: 34px; }
            .top-bar .q-number { font-size: 16px; }
            .top-bar .info { font-size: 10px; }
            .progress-box { font-size: 10px; padding: 3px 8px; min-width: 44px; border-radius: 5px; }
            .middle-section { flex: 0 0 28vh; max-height: 180px; min-height: 80px; }
            .img-side { flex: 0 0 40%; }
            .text-side p, .text-side-full p { font-size: 14px; }
            .text-side, .text-side-full { padding: 6px 8px; }
            .option-row { padding: 6px 8px; min-height: 36px; }
            .opt-letter { font-size: 14px; width: 28px; }
            .opt-text { font-size: 12px; }
            .opt-check { width: 20px; height: 20px; font-size: 14px; }
            .bottom-strip { height: 56px; bottom: 0px; padding: 2px 3px; gap: 2px; }
            .arrow-btn-wrap { width: 48px; height: 48px; }
            .arrow-btn { width: 48px; height: 48px; }
            .arrow-btn svg { width: 48px; height: 48px; }
            .q-dot { height: 20px; font-size: 8px; min-width: 14px; }
            .submit-btn { font-size: 10px; padding: 0 6px; height: 26px; }
            #activeTriangle { border-left: 8px solid transparent; border-right: 8px solid transparent; border-bottom: 12px solid #1F8C0C; }
        }

        @@media (min-width: 481px) and (max-width: 900px) {
                .page-wrapper {
                    height: calc(100vh - 66px);
                    height: calc(100dvh - 66px);
                }
            .top-bar { padding: 4px 10px; min-height: 38px; }
            .top-bar .q-number { font-size: 20px; }
            .top-bar .info { font-size: 11px; }
            .progress-box { font-size: 11px; padding: 4px 10px; min-width: 54px; }
            .middle-section { flex: 0 0 30vh; max-height: 210px; min-height: 90px; }
            .img-side { flex: 0 0 42%; }
            .text-side p, .text-side-full p { font-size: 16px; }
            .text-side, .text-side-full { padding: 8px 10px; }
            .option-row { padding: 7px 10px; min-height: 42px; }
            .opt-letter { font-size: 17px; width: 36px; }
            .opt-text { font-size: 14px; }
            .opt-check { width: 24px; height: 24px; font-size: 16px; }
            .bottom-strip { height: 66px; bottom: 0px; padding: 2px 4px; gap: 3px; }
            .arrow-btn-wrap { width: 60px; height: 60px; }
            .arrow-btn { width: 60px; height: 60px; }
            .arrow-btn svg { width: 60px; height: 60px; }
            .q-dot { height: 22px; font-size: 9px; min-width: 16px; }
            .submit-btn { font-size: 11px; padding: 0 8px; height: 28px; }
            #activeTriangle { border-left: 10px solid transparent; border-right: 10px solid transparent; border-bottom: 12px solid #1F8C0C; }
        }

        @@media (max-height: 500px) {
                .page-wrapper {
                    height: calc(100vh - 50px);
                    height: calc(100dvh - 50px);
                }
            .middle-section { flex: 0 0 20vh; max-height: 110px; min-height: 60px; }
            .top-bar { min-height: 30px; padding: 2px 8px; }
            .top-bar .q-number { font-size: 14px; }
            .top-bar .info { font-size: 9px; }
            .progress-box { font-size: 9px; padding: 2px 6px; min-width: 40px; }
            .text-side p, .text-side-full p { font-size: 13px; }
            .text-side, .text-side-full { padding: 4px 8px; }
            .option-row { min-height: 28px; padding: 3px 8px; }
            .opt-letter { font-size: 13px; width: 26px; }
            .opt-text { font-size: 11px; }
            .opt-check { width: 18px; height: 18px; font-size: 12px; }
            .bottom-strip { height: 50px; bottom: 0px; padding: 1px 3px; gap: 2px; }
            .arrow-btn-wrap { width: 44px; height: 44px; }
            .arrow-btn { width: 44px; height: 44px; }
            .arrow-btn svg { width: 44px; height: 44px; }
            .q-dot { height: 18px; font-size: 7px; min-width: 12px; }
            .submit-btn { font-size: 9px; padding: 0 5px; height: 22px; }
            #activeTriangle { border-left: 7px solid transparent; border-right: 7px solid transparent; border-bottom: 10px solid #1F8C0C; }
        }
    </style>
</head>
<body>

<!-- Triangle pointer - moved by JS, sits above the active dot -->
<div id="activeTriangle"></div>

<div class="popup-overlay" id="popupOverlay">
    <div class="popup-box">
        <h3>Submit Exam</h3>
        <p id="popupMsg">Are you sure you want to submit?</p>
        <div class="popup-btns">
            <button class="popup-btn-cancel" onclick="closePopup()">Continue Exam</button>
            <button class="popup-btn-ok" onclick="doSubmit()">Submit</button>
        </div>
    </div>
</div>

<form method="post" action="/Exam/Submit" id="examForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="moduleId" value="@moduleId" />
    <input type="hidden" name="sessionId" value="@sessionId" />

    <div class="page-wrapper">

        @for (int i = 0; i < Model.Count; i++)
        {
            var q = Model[i];
            <div id="qcard-@i" style="@(i == 0 ? "display:flex;" : "display:none;") flex-direction:column; flex:1; overflow:hidden; min-height:0;">

                <div class="top-bar">
                    <div class="info">Module @moduleId</div>
                    <div class="q-number">@(i + 1)</div>
                    <div class="progress-box">@(i + 1) / @Model.Count</div>
                </div>

                <div class="middle-section">
                    @if (!string.IsNullOrEmpty(q.ImagePath))
                    {
                        <div class="img-side">
                            <img src="@q.ImagePath" />
                        </div>
                        <div class="text-side">
                            <p>@q.QuestionText</p>
                        </div>
                    }
                    else
                    {
                        <div class="text-side-full">
                            <p>@q.QuestionText</p>
                        </div>
                    }
                </div>

                <div class="options-section">
                    @if (!string.IsNullOrWhiteSpace(q.OptionA))
                    {
                        <div class="option-row" id="opt-@i-A" onclick="selectOption(@i, 'A', this)">
                            <input type="radio" name="answers[@q.Id]" value="A" style="display:none" />
                            <div class="opt-letter">A</div>
                            <div class="opt-text">@q.OptionA</div>
                            <div class="opt-check" id="chk-@i-A"></div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(q.OptionB))
                    {
                        <div class="option-row" id="opt-@i-B" onclick="selectOption(@i, 'B', this)">
                            <input type="radio" name="answers[@q.Id]" value="B" style="display:none" />
                            <div class="opt-letter">B</div>
                            <div class="opt-text">@q.OptionB</div>
                            <div class="opt-check" id="chk-@i-B"></div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(q.OptionC))
                    {
                        <div class="option-row" id="opt-@i-C" onclick="selectOption(@i, 'C', this)">
                            <input type="radio" name="answers[@q.Id]" value="C" style="display:none" />
                            <div class="opt-letter">C</div>
                            <div class="opt-text">@q.OptionC</div>
                            <div class="opt-check" id="chk-@i-C"></div>
                        </div>
                    }
                </div>

            </div>
        }

        <div class="bottom-strip">
            <div class="arrow-btn-wrap" onclick="goPrev()">
                <button type="button" class="arrow-btn">
                    <svg width="88" height="88" viewBox="0 0 55 60">
                        <path d="M48,8 C52,8 54,12 52,16 L32,50 C30,54 25,54 23,50 L3,16 C1,12 3,8 7,8 Z" fill="#1F8C0C" transform="rotate(90,27.5,30)"/>
                        <text x="27.5" y="30" text-anchor="middle" dominant-baseline="central" font-size="15" font-weight="900" fill="#fff" font-family="Arial" id="prevNum">-</text>
                    </svg>
                </button>
            </div>

            <div class="q-nums-wrap" id="qStrip">
                @for (int i = 0; i < Model.Count; i++)
                {
                    <div class="q-dot @(i == 0 ? "active" : "")" id="qnum-@i" onclick="goToQuestion(@i)">@(i + 1)</div>
                }
            </div>

            <div class="arrow-btn-wrap" onclick="goNext()">
                <button type="button" class="arrow-btn">
                    <svg width="88" height="88" viewBox="0 0 55 60">
                        <path d="M48,8 C52,8 54,12 52,16 L32,50 C30,54 25,54 23,50 L3,16 C1,12 3,8 7,8 Z" fill="#1F8C0C" transform="rotate(-90,27.5,30)"/>
                        <text x="27.5" y="30" text-anchor="middle" dominant-baseline="central" font-size="15" font-weight="900" fill="#fff" font-family="Arial" id="nextNum">-</text>
                    </svg>
                </button>
            </div>

            <button type="button" class="submit-btn" id="submitBtn" onclick="confirmSubmit()">Submit</button>
        </div>

    </div>
</form>

<script>
    let currentQ = 0;
    let totalQ = @Model.Count;
    let answered = new Array(totalQ).fill(false);
    let selectedOptions = new Array(totalQ).fill(null);

    function moveTriangle(index) {
        var dot = document.getElementById('qnum-' + index);
        var tri = document.getElementById('activeTriangle');
        if (!dot || !tri) return;
        var rect = dot.getBoundingClientRect();
        var triWidth = tri.offsetWidth;
        // center triangle above the dot
        var leftPos = rect.left + (rect.width / 2) - 14;
        var topPos = rect.bottom -1;
        tri.style.left = leftPos + 'px';
        tri.style.top = topPos + 'px';
    }

    function updateArrowNums() {
        document.getElementById('prevNum').textContent = currentQ > 0 ? currentQ : '-';
        document.getElementById('nextNum').textContent = currentQ < totalQ - 1 ? (currentQ + 2) : '-';
    }

    function checkAllAnswered() {
        let allDone = answered.every(a => a === true);
        let btn = document.getElementById('submitBtn');
        if (allDone) btn.classList.add('visible');
        else btn.classList.remove('visible');
    }

    function goToQuestion(index) {
        document.getElementById('qcard-' + currentQ).style.display = 'none';
        document.getElementById('qnum-' + currentQ).classList.remove('active');
        if (answered[currentQ]) document.getElementById('qnum-' + currentQ).classList.add('answered');

        currentQ = index;

        document.getElementById('qcard-' + currentQ).style.display = 'flex';
        let numEl = document.getElementById('qnum-' + currentQ);
        numEl.classList.remove('answered');
        numEl.classList.add('active');

        updateArrowNums();
        moveTriangle(currentQ);

        let dot = document.getElementById('qnum-' + currentQ);
        if (dot) {
            dot.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
    }

    function goPrev() { if (currentQ > 0) goToQuestion(currentQ - 1); }
    function goNext() { if (currentQ < totalQ - 1) goToQuestion(currentQ + 1); }

    function selectOption(qIndex, option, rowEl) {
        if (selectedOptions[qIndex] === option) {
            rowEl.classList.remove('selected');
            rowEl.querySelector('input[type="radio"]').checked = false;
            rowEl.querySelector('.opt-check').innerText = '';
            selectedOptions[qIndex] = null;
            answered[qIndex] = false;
            document.getElementById('qnum-' + qIndex).classList.remove('answered');
            if (qIndex === currentQ) document.getElementById('qnum-' + qIndex).classList.add('active');
            checkAllAnswered();
            return;
        }

        let card = document.getElementById('qcard-' + qIndex);
        card.querySelectorAll('.option-row').forEach(r => {
            r.classList.remove('selected');
            r.querySelector('.opt-check').innerText = '';
            r.querySelector('input[type="radio"]').checked = false;
        });

        rowEl.classList.add('selected');
        rowEl.querySelector('input[type="radio"]').checked = true;
        rowEl.querySelector('.opt-check').innerText = '✕';
        selectedOptions[qIndex] = option;
        answered[qIndex] = true;

        document.getElementById('qnum-' + qIndex).classList.add('answered');
        if (qIndex === currentQ) document.getElementById('qnum-' + qIndex).classList.add('active');
        checkAllAnswered();
    }

    function confirmSubmit() {
        document.getElementById('popupMsg').innerText = 'All questions answered. Are you sure you want to submit?';
        document.getElementById('popupOverlay').classList.add('show');
    }

    function closePopup() { document.getElementById('popupOverlay').classList.remove('show'); }
    function doSubmit() { document.getElementById('examForm').submit(); }

    updateArrowNums();

    // Wait for layout then position triangle
    window.addEventListener('load', function() {
        moveTriangle(0);
    });

    window.addEventListener('resize', function() {
        moveTriangle(currentQ);
    });
</script>

</body>
</html>
