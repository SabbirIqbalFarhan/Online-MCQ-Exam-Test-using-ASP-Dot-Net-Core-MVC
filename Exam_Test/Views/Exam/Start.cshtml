@model List<Exam_Test.Models.Question>

@{
    ViewData["Title"] = "Exam";
    int moduleId = ViewBag.ModuleId;
    int sessionId = ViewBag.SessionId;
    string sessionTitle = ViewBag.SessionTitle;
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Module @moduleId Exam</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; background: #d0d0d0; }

        .page-wrapper {
            max-width: 960px;
            margin: 10px auto;
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        }

        .top-bar {
            background: #fff;
            border-bottom: 2px solid #ddd;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 16px;
        }

        .top-bar .info {
            font-size: 13px;
            color: #c00;
            font-weight: 700;
        }

        .top-bar .q-number {
            font-size: 28px;
            font-weight: 900;
            color: #222;
        }

        .progress-box {
            background: #4caf50;
            color: #fff;
            font-size: 14px;
            font-weight: 900;
            padding: 6px 16px;
            border-radius: 8px;
            min-width: 70px;
            text-align: center;
        }

        .middle-section {
            display: flex;
            border-bottom: 2px solid #ddd;
            min-height: 200px;
        }
        .img-side {
            flex: 0 0 45%;
            border-right: 2px solid #ddd;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px;
            background: #fafafa;
        }

        .img-side img {
            max-width: 100%;
            max-height: 220px;
            object-fit: contain;
        }

        .text-side {
            flex: 1;
            padding: 20px;
            display: flex;
            align-items: center;
        }

        .text-side-full {
            width: 100%;
            padding: 20px 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .text-side p, .text-side-full p {
            font-size: 15px;
            font-weight: 600;
            color: #222;
            line-height: 1.6;
        }

        .options-section {
            background: #fff;
        }

        .option-row {
            display: flex;
            align-items: center;
            border-bottom: 1px solid #ddd;
            padding: 14px 16px;
            cursor: pointer;
            transition: background 0.15s;
        }

        .option-row:hover { background: #f5f5f5; }
        .option-row.selected { background: #e8f5e9; }

        .opt-letter {
            font-size: 16px;
            font-weight: 900;
            color: #222;
            width: 30px;
            flex-shrink: 0;
        }

        .opt-text {
            flex: 1;
            font-size: 14px;
            color: #333;
        }

        .opt-check {
            width: 22px;
            height: 22px;
            border: 2px solid #aaa;
            border-radius: 4px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            font-size: 14px;
            font-weight: 900;
            color: #fff;
        }

        .option-row.selected .opt-check {
            background: #4caf50;
            border-color: #4caf50;
        }

        .bottom-strip {
            background: #e0e0e0;
            display: flex;
            align-items: center;
            padding: 8px 10px;
            gap: 5px;
            border-top: 2px solid #bbb;
        }

        .arrow-btn {
            background: #4caf50;
            color: #fff;
            border: none;
            border-radius: 6px;
            width: 36px;
            height: 36px;
            font-size: 20px;
            font-weight: 900;
            cursor: pointer;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .arrow-btn:hover { background: #388e3c; }

        .next-btn {
            background: #4caf50;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 0 16px;
            height: 36px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            flex-shrink: 0;
        }

        .next-btn:hover { background: #388e3c; }

        .q-nums-wrap {
            display: flex;
            gap: 4px;
            overflow-x: auto;
            align-items: center;
            flex: 1;
        }

        .q-dot {
            min-width: 30px;
            height: 30px;
            border-radius: 4px;
            background: #fff;
            border: 1px solid #bbb;
            color: #c00;
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
            transition: 0.15s;
        }

        .q-dot:hover { background: #f5f5f5; }
        .q-dot.active { background: #4caf50; color: #fff; border-color: #4caf50; }
        .q-dot.answered { background: #c8e6c9; color: #2e7d32; border-color: #81c784; }

        .submit-btn {
            background: #f44336;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 0 16px;
            height: 36px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            flex-shrink: 0;
        }

        .submit-btn:hover { background: #d32f2f; }

        /* POPUP */
        .popup-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 999;
            align-items: center;
            justify-content: center;
        }

        .popup-overlay.show { display: flex; }

        .popup-box {
            background: #fff;
            border-radius: 14px;
            padding: 28px 32px;
            max-width: 380px;
            width: 90%;
            text-align: center;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }

        .popup-box h3 {
            font-size: 18px;
            font-weight: 800;
            color: #1a2236;
            margin-bottom: 10px;
        }

        .popup-box p {
            font-size: 14px;
            color: #64748b;
            margin-bottom: 22px;
            line-height: 1.6;
        }

        .popup-btns {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .popup-btn-ok {
            background: #f44336;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
        }

        .popup-btn-cancel {
            background: #f1f5f9;
            color: #374151;
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
        }

        .popup-btn-ok:hover { background: #d32f2f; }
        .popup-btn-cancel:hover { background: #e2e8f0; }
    </style>
</head>
<body>

<!-- POPUP -->
<div class="popup-overlay" id="popupOverlay">
    <div class="popup-box">
        <h3>⚠️ Unanswered Questions</h3>
        <p id="popupMsg">You have unanswered questions. Do you want to submit anyway?</p>
        <div class="popup-btns">
            <button class="popup-btn-cancel" onclick="closePopup()">Continue Exam</button>
            <button class="popup-btn-ok" onclick="doSubmit()">Submit Anyway</button>
        </div>
    </div>
</div>

<form method="post" action="/Exam/Submit" id="examForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="moduleId" value="@moduleId" />
    <input type="hidden" name="sessionId" value="@sessionId" />

    <div class="page-wrapper">

        @for (int i = 0; i < Model.Count; i++)
        {
            var q = Model[i];
            <div id="qcard-@i" style="@(i == 0 ? "" : "display:none;")">

                <!-- TOP BAR -->
                <div class="top-bar">
                    <div class="info">Module @moduleId</div>
                    <div class="q-number">@(i + 1)</div>
                    <div class="progress-box" id="progressBox-@i">@(i+1) / @Model.Count</div>
                </div>

                <!-- MIDDLE -->
                <div class="middle-section">
                    @if (!string.IsNullOrEmpty(q.ImagePath))
                    {
                        <div class="img-side">
                            <img src="~/images/@q.ImagePath" />
                        </div>
                        <div class="text-side">
                            <p>@q.QuestionText</p>
                        </div>
                    }
                    else
                    {
                        <div class="text-side-full">
                            <p>@q.QuestionText</p>
                        </div>
                    }
                </div>

                <!-- OPTIONS -->
                <div class="options-section">
                    <div class="option-row" id="opt-@i-A" onclick="selectOption(@i, 'A', this)">
                        <input type="radio" name="answers[@q.Id]" value="A" style="display:none" />
                        <div class="opt-letter">A</div>
                        <div class="opt-text">@q.OptionA</div>
                        <div class="opt-check" id="chk-@i-A"></div>
                    </div>
                    <div class="option-row" id="opt-@i-B" onclick="selectOption(@i, 'B', this)">
                        <input type="radio" name="answers[@q.Id]" value="B" style="display:none" />
                        <div class="opt-letter">B</div>
                        <div class="opt-text">@q.OptionB</div>
                        <div class="opt-check" id="chk-@i-B"></div>
                    </div>
                    <div class="option-row" id="opt-@i-C" onclick="selectOption(@i, 'C', this)">
                        <input type="radio" name="answers[@q.Id]" value="C" style="display:none" />
                        <div class="opt-letter">C</div>
                        <div class="opt-text">@q.OptionC</div>
                        <div class="opt-check" id="chk-@i-C"></div>
                    </div>
                </div>

            </div>
        }

        <!-- BOTTOM STRIP -->
        <div class="bottom-strip">
            <button type="button" class="arrow-btn" onclick="goPrev()">&#8249;</button>
            <div class="q-nums-wrap" id="qStrip">
                @for (int i = 0; i < Model.Count; i++)
                {
                    <div class="q-dot @(i == 0 ? "active" : "")" id="qnum-@i" onclick="goToQuestion(@i)">@(i + 1)</div>
                }
            </div>
            <button type="button" class="next-btn" onclick="goNext()">Next ›</button>
            <button type="button" class="submit-btn" onclick="confirmSubmit()">Submit</button>
        </div>

    </div>
</form>

<script>
    let currentQ = 0;
    let totalQ = @Model.Count;
    let answered = new Array(totalQ).fill(false);
    let selectedOptions = new Array(totalQ).fill(null);

    function goToQuestion(index) {
        document.getElementById('qcard-' + currentQ).style.display = 'none';
        document.getElementById('qnum-' + currentQ).classList.remove('active');
        if (answered[currentQ]) {
            document.getElementById('qnum-' + currentQ).classList.add('answered');
        }

        currentQ = index;

        document.getElementById('qcard-' + currentQ).style.display = 'block';

        let numEl = document.getElementById('qnum-' + currentQ);
        numEl.classList.remove('answered');
        numEl.classList.add('active');

        document.getElementById('progressBox-' + currentQ).innerText = (currentQ + 1) + ' / ' + totalQ;

        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function goPrev() {
        if (currentQ > 0) goToQuestion(currentQ - 1);
    }

    function goNext() {
        if (currentQ < totalQ - 1) goToQuestion(currentQ + 1);
    }

    function selectOption(qIndex, option, rowEl) {
        // If already selected, uncheck it
        if (selectedOptions[qIndex] === option) {
            rowEl.classList.remove('selected');
            rowEl.querySelector('input[type="radio"]').checked = false;
            rowEl.querySelector('.opt-check').innerText = '';
            selectedOptions[qIndex] = null;
            answered[qIndex] = false;

            let numEl = document.getElementById('qnum-' + qIndex);
            numEl.classList.remove('answered');
            if (qIndex === currentQ) numEl.classList.add('active');
            return;
        }

        // Deselect all options for this question
        let card = document.getElementById('qcard-' + qIndex);
        card.querySelectorAll('.option-row').forEach(r => {
            r.classList.remove('selected');
            r.querySelector('.opt-check').innerText = '';
            r.querySelector('input[type="radio"]').checked = false;
        });

        // Select clicked option
        rowEl.classList.add('selected');
        rowEl.querySelector('input[type="radio"]').checked = true;
        rowEl.querySelector('.opt-check').innerText = '✓';
        selectedOptions[qIndex] = option;
        answered[qIndex] = true;

        let numEl = document.getElementById('qnum-' + qIndex);
        numEl.classList.add('answered');
        if (qIndex === currentQ) numEl.classList.add('active');
    }

    function confirmSubmit() {
        let count = answered.filter(a => a).length;
        let unanswered = totalQ - count;
        if (unanswered > 0) {
            document.getElementById('popupMsg').innerText =
                'You have ' + unanswered + ' unanswered question(s). Do you want to submit anyway?';
            document.getElementById('popupOverlay').classList.add('show');
        } else {
            if (confirm('All questions answered. Submit now?')) {
                document.getElementById('examForm').submit();
            }
        }
    }

    function closePopup() {
        document.getElementById('popupOverlay').classList.remove('show');
    }

    function doSubmit() {
        document.getElementById('examForm').submit();
    }
</script>

</body>
</html>