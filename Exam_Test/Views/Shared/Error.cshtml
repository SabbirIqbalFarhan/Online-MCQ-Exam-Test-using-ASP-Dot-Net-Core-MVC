@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<style>
    .error-container {
        max-width: 700px;
        margin: 40px auto;
        padding: 24px 20px;
        box-sizing: border-box;
    }

    .error-title {
        font-size: clamp(1.4rem, 5vw, 2rem);
        color: #dc3545;
        margin-bottom: 8px;
    }

    .error-subtitle {
        font-size: clamp(1rem, 3.5vw, 1.3rem);
        color: #dc3545;
        margin-bottom: 20px;
    }

    .error-request-id {
        font-size: 0.9rem;
        word-break: break-all;
        margin-bottom: 20px;
    }

        .error-request-id code {
            background: #f4f4f4;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.85rem;
        }

    .error-dev-section h3 {
        font-size: clamp(1rem, 3vw, 1.2rem);
        margin-bottom: 10px;
    }

    .error-dev-section p {
        font-size: clamp(0.85rem, 2.5vw, 1rem);
        line-height: 1.6;
        margin-bottom: 12px;
        color: #444;
    }

    @@media (max-width: 480px) {
        .error-container {
            margin: 20px auto;
            padding: 16px 14px;
        }
    }
</style>

<div class="error-container">
    <h1 class="error-title">Error.</h1>
    <h2 class="error-subtitle">An error occurred while processing your request.</h2>

    @if (Model.ShowRequestId)
    {
        <p class="error-request-id">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <div class="error-dev-section">
        <h3>Development Mode</h3>
        <p>
            Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
        </p>
        <p>
            <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
            It can result in displaying sensitive information from exceptions to end users.
            For local debugging, enable the <strong>Development</strong> environment by setting the
            <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong>
            and restarting the app.
        </p>
    </div>
</div>