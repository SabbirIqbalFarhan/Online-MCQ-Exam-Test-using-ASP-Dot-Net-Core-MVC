@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .admin-wrap {
        display: flex;
        min-height: calc(100vh - 60px);
        background: #f1f4fb;
        margin: -28px;
    }

    /* ── Sidebar ── */
    .dash-sidebar {
        width: 230px;
        background: #1a2236;
        flex-shrink: 0;
        padding: 60px 0 24px;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        transition: transform 0.3s ease;
        z-index: 100;
    }

    .nav-section-label {
        font-size: 9.5px;
        font-weight: 700;
        color: rgba(240,244,255,0.35);
        text-transform: uppercase;
        letter-spacing: 1.4px;
        padding: 14px 20px 6px;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 9px 20px;
        color: rgba(240,244,255,0.62);
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        border-left: 3px solid transparent;
        transition: all 0.18s;
    }

    .sidebar-link:hover { color: #fff; background: rgba(99,91,255,0.1); border-left-color: rgba(99,91,255,0.5); }
    .sidebar-link.active { color: #fff; background: rgba(99,91,255,0.15); border-left-color: #635bff; }

    .sidebar-link .s-icon {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        display: grid;
        place-items: center;
        font-size: 14px;
        flex-shrink: 0;
        background: rgba(255,255,255,0.06);
        transition: 0.18s;
    }

    .sidebar-link:hover .s-icon,
    .sidebar-link.active .s-icon { background: rgba(99,91,255,0.25); }

    /* ── Mobile menu toggle ── */
    .sidebar-toggle {
        display: none;
        position: fixed;
        top: 14px;
        left: 14px;
        z-index: 200;
        background: #635bff;
        border: none;
        color: #fff;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        font-size: 16px;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(99,91,255,0.4);
    }

    .sidebar-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        z-index: 99;
    }

    /* ── Main ── */
    .dash-main {
        flex: 1;
        padding: 28px;
        overflow-y: auto;
        min-width: 0;
    }

    .page-header { margin-bottom: 24px; }
    .page-header h2 { font-size: 22px; font-weight: 800; color: #1a2236; margin: 0 0 4px; }
    .page-header p { font-size: 13px; color: #64748b; margin: 0; }

    /* ── Stats ── */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 28px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #e5e9f2;
        border-radius: 14px;
        padding: 20px 22px;
        box-shadow: 0 2px 8px rgba(26,34,54,0.04);
    }

    .stat-card .s-label { font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; }
    .stat-card .s-icon-wrap { font-size: 22px; margin-bottom: 10px; }
    .stat-card .s-value { font-size: 32px; font-weight: 800; line-height: 1; }
    .stat-card.users .s-value { color: #635bff; }
    .stat-card.q .s-value { color: #10b981; }
    .stat-card.results .s-value { color: #06b6d4; }
    .stat-card.pending .s-value { color: #f59e0b; }

    /* ── Actions ── */
    .section-title { font-size: 14px; font-weight: 700; color: #1a2236; margin-bottom: 14px; }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        margin-bottom: 28px;
    }

    .action-card {
        background: #fff;
        border: 1px solid #e5e9f2;
        border-radius: 16px;
        padding: 22px;
        text-decoration: none;
        color: #1a2236;
        transition: 0.2s;
        display: flex;
        flex-direction: column;
        gap: 6px;
        box-shadow: 0 2px 8px rgba(26,34,54,0.04);
    }

    .action-card:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(26,34,54,0.1); border-color: #d4d0ff; color: #1a2236; }
    .action-card .a-icon { width: 46px; height: 46px; border-radius: 12px; background: rgba(99,91,255,0.1); display: grid; place-items: center; font-size: 22px; margin-bottom: 6px; }
    .action-card .a-title { font-size: 14px; font-weight: 700; color: #1a2236; }
    .action-card .a-desc { font-size: 12.5px; color: #64748b; }

    .module-pill { background: rgba(99,91,255,0.1); color: #635bff; padding: 3px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 700; }

    /* ── Tablet ── */
    @@media (max-width: 1024px) {
        .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    /* ── Mobile ── */
    @@media (max-width: 768px) {
        .sidebar-toggle { display: grid; place-items: center; }

        .dash-sidebar {
            position: fixed;
            left: 0;
            top: 0;
            height: 100vh;
            transform: translateX(-100%);
        }

        .dash-sidebar.open { transform: translateX(0); }
        .sidebar-overlay.open { display: block; }

        .admin-wrap { margin: -16px; }

        .dash-main { padding: 16px; padding-top: 56px; }

        .page-header h2 { font-size: 18px; }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .stat-card { padding: 16px; }
        .stat-card .s-value { font-size: 26px; }
        .stat-card .s-icon-wrap { font-size: 18px; margin-bottom: 6px; }

        .actions-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .action-card { padding: 16px; flex-direction: row; align-items: center; gap: 14px; }
        .action-card .a-icon { margin-bottom: 0; flex-shrink: 0; width: 40px; height: 40px; font-size: 18px; }
    }

    @@media (max-width: 400px) {
        .stats-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
        .stat-card .s-value { font-size: 22px; }
    }
</style>

<!-- Mobile sidebar toggle button -->
<button class="sidebar-toggle" onclick="toggleSidebar()">
    <i class="fa-solid fa-bars"></i>
</button>

<!-- Overlay for mobile -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

<div class="admin-wrap">
    <div class="dash-sidebar" id="dashSidebar">
        <div class="nav-section-label">Main</div>
        <a class="sidebar-link active" href="/Admin/Dashboard">
            <span class="s-icon">📊</span><span>Dashboard</span>
        </a>
        <div class="nav-section-label">Users</div>
        <a class="sidebar-link" href="/AdminUser">
            <span class="s-icon">👥</span><span>All Users</span>
        </a>
        <div class="nav-section-label">Questions</div>
        <a class="sidebar-link" href="/Admin/Questions?moduleId=1">
            <span class="s-icon">📝</span><span>Module 1</span>
        </a>
        <a class="sidebar-link" href="/Admin/Questions?moduleId=2">
            <span class="s-icon">📝</span><span>Module 2</span>
        </a>
        <a class="sidebar-link" href="/Admin/Questions?moduleId=3">
            <span class="s-icon">📝</span><span>Module 3</span>
        </a>
        <div class="nav-section-label">Sessions</div>
        <a class="sidebar-link" href="/AdminSession">
            <span class="s-icon">🕐</span><span>Exam Sessions</span>
        </a>
    </div>

    <div class="dash-main">

        <div class="page-header">
            <h2>Dashboard</h2>
            <p>Welcome back, Admin. Here's what's happening.</p>
        </div>

        <div class="stats-grid">
            <div class="stat-card users">
                <div class="s-icon-wrap">👥</div>
                <div class="s-label">Total Users</div>
                <div class="s-value">@ViewBag.TotalUsers</div>
            </div>
            <div class="stat-card q">
                <div class="s-icon-wrap">📝</div>
                <div class="s-label">Total Questions</div>
                <div class="s-value">@ViewBag.TotalQuestions</div>
            </div>
            <div class="stat-card results">
                <div class="s-icon-wrap">🗂️</div>
                <div class="s-label">Total Sessions</div>
                <div class="s-value">@ViewBag.TotalSessions</div>
            </div>
            <div class="stat-card pending">
                <div class="s-icon-wrap">⏳</div>
                <div class="s-label">Pending Requests</div>
                <div class="s-value">@ViewBag.PendingRequests</div>
            </div>
        </div>

        <div class="section-title">
            <i class="fa-solid fa-bolt" style="color:#635bff;margin-right:7px;"></i>
            Quick Actions
        </div>
        <div class="actions-grid">
            <a class="action-card" href="/AdminUser">
                <div class="a-icon">👥</div>
                <div>
                    <div class="a-title">Manage Users</div>
                    <div class="a-desc">Grant or revoke exam permissions</div>
                </div>
            </a>
            <a class="action-card" href="/Admin/Questions?moduleId=1">
                <div class="a-icon">📝</div>
                <div>
                    <div class="a-title">Manage Questions</div>
                    <div class="a-desc">Add, edit or delete exam questions</div>
                </div>
            </a>
            <a class="action-card" href="/AdminSession">
                <div class="a-icon">🕐</div>
                <div>
                    <div class="a-title">Exam Sessions</div>
                    <div class="a-desc">Create and manage exam sessions</div>
                </div>
            </a>
            <a class="action-card" href="/AdminUser">
                <div class="a-icon">⏳</div>
                <div>
                    <div class="a-title">Pending Requests</div>
                    <div class="a-desc">Review and approve exam access requests</div>
                </div>
            </a>
        </div>

    </div>
</div>

<script>
    function toggleSidebar() {
        document.getElementById('dashSidebar').classList.toggle('open');
        document.getElementById('sidebarOverlay').classList.toggle('open');
    }
</script>